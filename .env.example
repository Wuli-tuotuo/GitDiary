# GitHub OAuth 配置（在 GitHub Settings > Developer settings > OAuth Apps 中创建）
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost/oauth/callback

# MySQL 数据库密码
MYSQL_ROOT_PASSWORD=gitdiary123
MYSQL_PASSWORD=gitdiary123

# JWT 密钥（生产环境请修改为随机字符串）
JWT_SECRET=gitdiary-production-secret-key-please-change-this-1234567890

# AI 大模型配置（硅基流动 https://cloud.siliconflow.cn/）
AI_API_KEY=your_siliconflow_api_key
AI_MODEL=Qwen/Qwen2.5-7B-Instruct
